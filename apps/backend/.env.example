# Backend configuration. Copy to `.env` and fill in as needed.
# The app is fully functional with NONE of these set (deterministic analytics
# and rule-based categorization; the LLM layer is simply skipped).

# --- LLM layer (build-plan #8 part 2) ----------------------------------------
# Provider and model are configured separately. LLM_PROVIDER picks which is
# tried first; the other, if its key is present, is a fallback used ONLY on a
# provider failure (timeout / rate limit / API error) -- never on a
# low-confidence answer.
LLM_PROVIDER=openai            # openai | anthropic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Dev only. In the packaged desktop app these come from the OS keychain via
# Electron safeStorage, injected into the backend process (build-plan #9). The
# renderer never sees a key.

# --- database (optional override) ------------------------------------------
# APP_DATABASE_URL=sqlite:///./data/app.db
